<!DOCTYPE html>
<html lang="nl">
  <head>
    <%- include('partials/head') %>
    <style>
      /* Kitchen CV Page - Elegant Theme-Aware CSS */
      .keuken-cv-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 2rem;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--surface-border);
      }

      .keuken-cv-header h2 {
        font-family: 'Syne', sans-serif;
        font-size: 2rem;
        margin: 0;
      }

      .keuken-cv-paper {
        display: flex;
        background: var(--surface-strong);
        border: 1px solid var(--surface-border);
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow);
        overflow: hidden;
        margin-bottom: 3rem;
        transition: background-color 0.3s ease, border-color 0.3s ease;
      }

      /* Sidebar Column */
      .keuken-sidebar {
        width: 32%;
        background: rgba(255, 255, 255, 0.02);
        border-right: 1px solid var(--surface-border);
        padding: 3rem 2rem;
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
      }

      [data-theme="light"] .keuken-sidebar {
        background: rgba(0, 0, 0, 0.02);
      }

      .keuken-profile-wrap {
        text-align: center;
      }

      .keuken-avatar {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid var(--primary);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
        margin-bottom: 1.5rem;
        transition: transform 0.3s ease;
      }

      .keuken-avatar:hover {
        transform: scale(1.03);
      }

      .keuken-name h1 {
        font-family: 'Syne', sans-serif;
        font-size: 1.8rem;
        margin: 0 0 0.5rem;
        line-height: 1.1;
        color: var(--text);
      }

      .keuken-subtitle {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--primary);
        border-bottom: 2px solid var(--primary);
        padding-bottom: 0.75rem;
        margin-bottom: 0;
      }

      .keuken-section h3 {
        font-family: 'Syne', sans-serif;
        font-size: 1.2rem;
        margin-top: 0;
        margin-bottom: 1rem;
        color: var(--text);
        border-bottom: 1px dashed var(--surface-border);
        padding-bottom: 0.5rem;
      }

      .keuken-contact-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
      }

      .keuken-contact-list li {
        font-size: 0.95rem;
        line-height: 1.4;
      }

      .keuken-contact-list strong {
        color: var(--muted);
        display: block;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .keuken-contact-list a {
        color: var(--text);
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: border-color 0.2s, color 0.2s;
      }

      .keuken-contact-list a:hover {
        color: var(--primary);
        border-color: var(--primary);
      }

      .keuken-sidebar-text {
        font-size: 0.9rem;
        line-height: 1.5;
        color: var(--muted);
      }

      .keuken-expertise-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .keuken-tag {
        background: rgba(255, 141, 92, 0.1);
        color: var(--primary);
        border: 1px solid rgba(255, 141, 92, 0.2);
        padding: 0.3rem 0.75rem;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 500;
      }

      /* Bridge Callout Banner */
      .keuken-bridge-banner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.5rem;
        background: radial-gradient(circle at top left, rgba(255, 141, 92, 0.12), transparent 50%),
                    linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
        border: 1px solid rgba(255, 141, 92, 0.3);
        border-radius: var(--radius-lg);
        padding: 1.25rem 1.75rem;
        margin-bottom: 2rem;
      }

      [data-theme="light"] .keuken-bridge-banner {
        background: radial-gradient(circle at top left, rgba(214, 92, 39, 0.08), transparent 50%),
                    linear-gradient(180deg, rgba(255, 255, 255, 0.95), rgba(243, 237, 228, 0.85));
        border-color: rgba(214, 92, 39, 0.3);
      }

      .keuken-bridge-text strong {
        display: block;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 0.35rem;
      }

      .keuken-bridge-text p {
        margin: 0;
        font-size: 0.95rem;
        line-height: 1.5;
        color: var(--muted);
      }

      .btn-bridge-nav {
        white-space: nowrap;
        flex-shrink: 0;
      }

      @media (max-width: 760px) {
        .keuken-bridge-banner {
          flex-direction: column;
          align-items: flex-start;
        }
        .btn-bridge-nav {
          width: 100%;
        }
      }

      /* Main Column */
      .keuken-content {
        width: 68%;
        padding: 3rem 3.5rem;
        display: flex;
        flex-direction: column;
        gap: 3rem;
      }

      .keuken-main-section h2 {
        font-family: 'Syne', sans-serif;
        font-size: 1.5rem;
        color: var(--text);
        margin-top: 0;
        margin-bottom: 1.5rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-bottom: 2px solid var(--primary);
        padding-bottom: 0.4rem;
        display: inline-block;
      }

      .keuken-intro-p {
        font-size: 1.05rem;
        line-height: 1.6;
        color: var(--text);
        margin: 0;
      }

      .keuken-timeline {
        display: flex;
        flex-direction: column;
        gap: 1.8rem;
      }

      .keuken-job {
        position: relative;
        padding-left: 0;
      }

      .keuken-job-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        margin-bottom: 0.4rem;
      }

      .keuken-job-header h3 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.2rem;
        font-weight: 700;
        margin: 0;
        color: var(--text);
      }

      .keuken-job-period {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        color: var(--primary);
        font-size: 0.95rem;
        white-space: nowrap;
      }

      .keuken-job-sub {
        display: flex;
        gap: 1rem;
        font-size: 0.9rem;
        color: var(--muted);
        margin-bottom: 0.5rem;
      }

      .keuken-job-role {
        font-weight: 600;
        color: var(--secondary);
      }

      [data-theme="light"] .keuken-job-role {
        color: var(--secondary);
      }

      .keuken-job-desc {
        font-size: 0.95rem;
        line-height: 1.5;
        color: var(--muted);
        margin: 0;
      }

      /* Print Optimization */
      @media print {
        body {
          background: #fff !important;
          color: #000 !important;
          padding: 0 !important;
        }

        .page-shell {
          background: #fff !important;
        }

        .noise-overlay,
        .page-orb,
        .nav,
        .footer,
        .keuken-cv-header,
        .keuken-bridge-banner {
          display: none !important;
        }

        .keuken-cv-paper {
          display: flex !important;
          border: none !important;
          box-shadow: none !important;
          background: #fff !important;
          border-radius: 0 !important;
          width: 100% !important;
          margin: 0 !important;
          overflow: visible !important;
        }

        .keuken-sidebar {
          width: 30% !important;
          background: #fdfdfd !important;
          border-right: 1px solid #ddd !important;
          padding: 2cm 1cm !important;
        }

        .keuken-content {
          width: 70% !important;
          padding: 2cm 1.2cm !important;
          background: #fff !important;
        }

        .keuken-avatar {
          border: 3px solid #e67e22 !important;
        }

        .keuken-subtitle {
          border-bottom: 2px solid #e67e22 !important;
          color: #e67e22 !important;
        }

        .keuken-main-section h2 {
          border-bottom: 2px solid #e67e22 !important;
        }

        .keuken-job-period {
          color: #e67e22 !important;
        }

        .keuken-job-role {
          color: #2c3e50 !important;
        }

        .keuken-tag {
          border: 1px solid #ddd !important;
          color: #000 !important;
          background: none !important;
        }
      }

      /* Mobile responsiviteit */
      @media (max-width: 900px) {
        .keuken-cv-paper {
          flex-direction: column;
        }

        .keuken-sidebar {
          width: 100%;
          border-right: none;
          border-bottom: 1px solid var(--surface-border);
          padding: 2.5rem 1.5rem;
          align-items: center;
          text-align: center;
        }

        .keuken-expertise-tags {
          justify-content: center;
        }

        .keuken-content {
          width: 100%;
          padding: 2.5rem 1.5rem;
        }

        .keuken-job-header {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.2rem;
        }
      }
    </style>
  </head>
