<aside id="secretaryWidget" class="secretary-widget" aria-label="Portfolio Secretary Assistent">
  <!-- Floating Trigger Button -->
  <button id="secretaryToggleBtn" class="secretary-toggle-btn" aria-expanded="false" aria-controls="secretaryPanel" aria-label="Open Portfolio Secretary Chat">
    <span class="secretary-toggle-icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
      </svg>
    </span>
    <span class="secretary-toggle-label">Portfolio Secretary</span>
    <span class="secretary-unread-badge" id="secretaryBadge" style="display: none;">1</span>
  </button>

  <!-- Secretary Panel Card -->
  <div id="secretaryPanel" class="secretary-panel" aria-hidden="true">
    <div class="secretary-header">
      <div class="secretary-title-wrap">
        <div class="secretary-avatar-icon" aria-hidden="true">JH</div>
        <div>
          <h3 class="secretary-title">Portfolio Secretary</h3>
          <p class="secretary-subtitle">Deterministische Vragen- &amp; Navigatiehulp</p>
        </div>
      </div>
      <button id="secretaryCloseBtn" class="secretary-close-btn" type="button" aria-label="Sluit assistent">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Suggested Questions Chips Bar -->
    <div class="secretary-suggestions" aria-label="Voorgestelde vragen">
      <span class="suggestions-label">Snelvragen:</span>
      <div class="chips-scroll-container">
        <button type="button" class="secretary-chip" data-query="Wat doet Jaap?">Wat doet Jaap?</button>
        <button type="button" class="secretary-chip" data-query="Welke projecten heeft hij gebouwd?">Welke projecten?</button>
        <button type="button" class="secretary-chip" data-query="Heeft hij ook ervaring in de keuken?">Keuken-CV?</button>
        <button type="button" class="secretary-chip" data-query="Hoe neem ik contact op per e-mail?">Contact opnemen?</button>
      </div>
    </div>

    <!-- Conversation History Window -->
    <div id="secretaryChatHistory" class="secretary-chat-history" aria-live="polite" role="log">
      <!-- Default Welcome Message -->
      <div class="secretary-msg assistant-msg">
        <div class="msg-content">
          <p>Hallo! Ik ben de Portfolio Secretary. Ik beantwoord vragen over Jaap's profiel, projecten, skills en achtergrond op basis van de site-kennisbank.</p>
          <p class="msg-sub">Stel hieronder een vraag of klik op een van de snelvragen!</p>
        </div>
      </div>
    </div>

    <!-- Query Input Form -->
    <form id="secretaryForm" class="secretary-form">
      <div class="input-wrap">
        <input type="text" id="secretaryInput" class="secretary-input" placeholder="Stel een vraag (bijv. 'Welke projecten?')..." autocomplete="off" aria-label="Stel een vraag aan de Portfolio Secretary" />
        <button type="submit" class="secretary-send-btn" aria-label="Verstuur vraag">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
        </button>
      </div>
    </form>
  </div>
</aside>

<script src="/secretary-engine.js" defer></script>
<script src="/secretary-llm-adapter.js" defer></script>
<script src="/secretary-ui.js" defer></script>
