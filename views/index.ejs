<!DOCTYPE html>
<html lang="nl">
  <head>
    <%- include('partials/head') %>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Ga naar hoofdinhoud</a>
    <div class="page-shell">
      <div class="noise-overlay" aria-hidden="true"></div>
      <div class="page-orb page-orb-a" aria-hidden="true"></div>
      <div class="page-orb page-orb-b" aria-hidden="true"></div>

      <header class="hero" id="top">
        <%- include('partials/nav') %>

        <div class="hero-backdrop" aria-hidden="true">
          <div class="hero-glow-a"></div>
          <div class="hero-glow-b"></div>
          <div class="grid-pattern"></div>
        </div>

        <div class="hero-content container">
          <div class="hero-copy">
            <div class="hero-badge">
              <span class="status-pulse"></span>
              Developer &amp; Creative Technologist
            </div>
            <h1>
              Ik bouw doordachte digitale producten met <span class="text-gradient">code, karakter en regie.</span>
            </h1>
            <p class="subtitle">
              Ik bouw webapplicaties en creatieve tools: van een platform voor vinyl tot een tabletop-game en een fondsenwervingssite.
              Mijn kennis van webdevelopment heb ik zelfstandig opgebouwd met cursussen en praktijkprojecten. Vanuit mijn achtergrond in horeca en muziek werk ik pragmatisch: begrijpen, bouwen, testen en verbeteren.
            </p>
            <div class="hero-actions">
              <a class="btn btn-primary" href="#projecten">Bekijk projecten &rarr;</a>
              <a class="btn btn-secondary" href="#contact">Neem contact op</a>
              <a class="btn btn-ghost share-btn-accent" href="/share">Deel / QR</a>
              <a class="btn btn-ghost" href="https://github.com/japiohopman" target="_blank" rel="noreferrer">
                GitHub &rarr;
              </a>
            </div>

            <div class="hero-highlights">
              <div class="highlight-item">
                <span class="highlight-label">Kernstack</span>
                <span class="highlight-val">TypeScript, React, Node.js, Next.js</span>
              </div>
              <div class="highlight-item">
                <span class="highlight-label">Focus</span>
                <span class="highlight-val">Webapps, games en AI-integraties</span>
              </div>
              <div class="highlight-item">
                <span class="highlight-label">Werkwijze</span>
                <span class="highlight-val">Zelfstandig geleerd &middot; Projectgericht gebouwd</span>
              </div>
            </div>
          </div>

          <aside class="hero-panel">
            <div class="portrait-card">
              <div class="portrait-wrap">
                <div class="avatar-container">
                  <img src="/images/jaap-Hopman.webp" alt="Portret van Jaap Hopman" class="avatar avatar-default" onerror="this.onerror=null; this.src='/images/jaap-hopman.webp'; this.setAttribute('onerror', 'this.onerror=null; this.src=\'/images/jaap-Hopman.jpg\';');" />
                  <img src="/images/jaap-Hopman-muppet.webp" alt="Portret van Jaap Hopman (Muppet)" class="avatar avatar-hover" onerror="this.onerror=null; this.src='/images/jaap-hopman-muppet.webp';" />
                </div>
              </div>
              <div class="portrait-meta">
                <p class="portrait-name">Jaap Hopman</p>
                <p class="portrait-role">Creative Technologist</p>
              </div>
            </div>
          </aside>
        </div>
      </header>

      <main id="main-content" tabindex="-1">
        <%- include('partials/projecten') %>
        <%- include('partials/skills') %>
        <%- include('partials/over') %>
        <%- include('partials/ervaring') %>
      </main>

      <%- include('partials/footer') %>
      <%- include('partials/secretary') %>
    </div>
  </body>
</html>